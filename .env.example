# ========================================================
# Configurações do GraphPoliticsRAG
# Copie este arquivo para .env e preencha com suas credenciais.
# NUNCA comite o arquivo .env no Git.
# ========================================================

# Neo4j Graph Database
NEO4J_URI=neo4j+s://<seu-cluster>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=<sua-senha-neo4j>

# Provedores de Inteligência Artificial
# Obtenha sua chave em: https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# Opcional: Gemini para extração e respostas avançadas
# Obtenha sua chave em: https://aistudio.google.com/
GEMINI_API_KEY=...

# Modelos Groq configuráveis (opcionais, possuem valores padrão)
GROQ_EXTRACTION_MODEL=openai/gpt-oss-120b
GROQ_CHAT_MODEL=openai/gpt-oss-20b

# Segurança e CORS
# Em produção, liste os domínios frontend separados por vírgula.
# Exemplo: https://meuapp.com,https://painel.meuapp.com
CORS_ORIGINS=http://localhost:4200,http://localhost:8000,http://127.0.0.1:4200

# Ambiente de execução (development | production)
ENVIRONMENT=development

# Porta do servidor (opcional, padrão: 8000)
PORT=8000
